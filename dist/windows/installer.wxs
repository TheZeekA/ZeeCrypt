<?xml version="1.0" encoding="UTF-8"?>
<!--
  ZeeCrypt MSI installer, built with WiX Toolset v5 (https://wixtoolset.org/).

  Build (from repo root, after ZeeCrypt.exe and images/lock.ico exist).
  Note: the double-hyphen flags below use U+2011 (non-breaking hyphen)
  instead of two consecutive ASCII hyphens, since that sequence isn't
  allowed inside an XML comment. Retype the flags with real hyphens
  before running this in a shell:
    dotnet tool install ‑‑global wix ‑‑version 5.0.2
    wix extension add WixToolset.UI.wixext/5.0.2
    wix build dist/windows/installer.wxs -arch x64 -ext WixToolset.UI.wixext -d ExePath=src/ZeeCrypt.exe -d IconPath=images/lock.ico -d LicenseRtfPath=dist/windows/License.rtf -d ProductVersion=2.0.0.0 -o ZeeCrypt-Installer.msi

  Pinned to WiX v5: v7 introduced a mandatory "Open Source Maintenance Fee"
  EULA that must be accepted before the tool will run at all. Don't bump
  the major version here without checking the licensing terms first.

  Installs per-machine (to Program Files), which requires a UAC admin
  prompt during install. An earlier per-user (no-admin) version of this
  installer silently completed without actually installing anything -
  install-time behavior can only be verified on a real Windows machine
  (nothing in CI actually runs the installer, only builds it), so this
  switched to the standard, far more common and better-tested per-machine
  path rather than continuing to debug the per-user install blind.

  IMPORTANT: UpgradeCode must never change across releases - it's what lets
  Windows Installer detect and upgrade a previous ZeeCrypt install instead of
  treating a new version as an unrelated product.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="ZeeCrypt"
           Manufacturer="Teddy Jones"
           Version="$(var.ProductVersion)"
           UpgradeCode="fcc59afd-06ce-40f0-8de0-46e02636afff"
           Language="1033"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of ZeeCrypt is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/TheZeekA/ZeeCrypt" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/TheZeekA/ZeeCrypt" />

    <!--
      Standard WiX license+progress+"Setup was successful" dialog flow.
      There's no simpler built-in dialog set that skips straight to just a
      success screen - every stock WixUI sequence includes the license
      agreement dialog first. Showing the GPL-3.0 text during install is
      normal practice for GPL software anyway, so this uses it as-is rather
      than authoring a fully custom dialog set just to avoid it.
    -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtfPath)" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="APPFOLDER" Name="ZeeCrypt" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="ZeeCrypt" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="ZeeCrypt" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="APPFOLDER">
      <!-- Main executable + Start Menu and Desktop shortcuts -->
      <Component Id="MainExecutable" Guid="*">
        <File Id="ZeeCryptEXE" Source="$(var.ExePath)" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut"
                     Directory="ApplicationProgramsFolder"
                     Name="ZeeCrypt"
                     WorkingDirectory="APPFOLDER"
                     Icon="AppIcon.ico" />
          <Shortcut Id="DesktopShortcut"
                     Directory="DesktopFolder"
                     Name="ZeeCrypt"
                     WorkingDirectory="APPFOLDER"
                     Icon="AppIcon.ico" />
        </File>
      </Component>

      <!--
        .pcv file association. HKCR is the correct root for a per-machine
        install: WiX/Windows Installer resolves it to
        HKEY_LOCAL_MACHINE\Software\Classes, which is visible to every user
        on the machine (as opposed to HKCU, which would only apply to
        whichever account happened to run the elevated installer).
      -->
      <Component Id="FileAssociation" Guid="*">
        <RegistryValue Root="HKCR" Key=".pcv" Value="ZeeCrypt.pcv" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKCR" Key="ZeeCrypt.pcv" Value="ZeeCrypt Encrypted Volume" Type="string" />
        <RegistryValue Root="HKCR" Key="ZeeCrypt.pcv\DefaultIcon" Value="[APPFOLDER]ZeeCrypt.exe,0" Type="string" />
        <RegistryValue Root="HKCR" Key="ZeeCrypt.pcv\shell\open\command" Value="&quot;[APPFOLDER]ZeeCrypt.exe&quot; -- &quot;%1&quot;" Type="string" />
      </Component>

      <!-- Clean up the Start Menu folder on uninstall -->
      <Component Id="RemoveStartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="*">
        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKLM" Key="Software\ZeeCrypt" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!--
        Explorer right-click integration (classic menu; on Windows 11 these
        are under "Show more options").

        - "Open with ZeeCrypt" on files and folders: auto-detects encrypt or
          decrypt (.pcv or a .pcv.N chunk means decrypt, see onDrop()).
        - "Encrypt with ZeeCrypt" on files (except .pcv) and folders: always
          encrypts.
        - "Decrypt with ZeeCrypt" on .pcv files: always decrypts.

        "%1" is quoted so a path containing spaces arrives as one argument,
        and "-" "-" (two hyphens) ends ZeeCrypt's options, so a file named
        "-x" is still a path. MultiSelectModel=Player keeps a verb visible
        for any number of selected items. Explorer starts one process per
        item; the first becomes the window and the rest forward their paths
        to it over a named pipe (src/instance.go), which merges them into one
        drop. The Decrypt verb is Single: ZeeCrypt decrypts one volume at a
        time.
      -->
      <Component Id="ContextMenuFiles" Guid="*">
        <RegistryValue Root="HKCR" Key="*\shell\ZeeCrypt" Value="Open with ZeeCrypt" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKCR" Key="*\shell\ZeeCrypt" Name="Icon" Value="[APPFOLDER]ZeeCrypt.exe,0" Type="string" />
        <RegistryValue Root="HKCR" Key="*\shell\ZeeCrypt" Name="MultiSelectModel" Value="Player" Type="string" />
        <RegistryValue Root="HKCR" Key="*\shell\ZeeCrypt\command" Value="&quot;[APPFOLDER]ZeeCrypt.exe&quot; -- &quot;%1&quot;" Type="string" />
      </Component>

      <Component Id="ContextMenuFolders" Guid="*">
        <RegistryValue Root="HKCR" Key="Directory\shell\ZeeCrypt" Value="Open with ZeeCrypt" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKCR" Key="Directory\shell\ZeeCrypt" Name="Icon" Value="[APPFOLDER]ZeeCrypt.exe,0" Type="string" />
        <RegistryValue Root="HKCR" Key="Directory\shell\ZeeCrypt" Name="MultiSelectModel" Value="Player" Type="string" />
        <RegistryValue Root="HKCR" Key="Directory\shell\ZeeCrypt\command" Value="&quot;[APPFOLDER]ZeeCrypt.exe&quot; -- &quot;%1&quot;" Type="string" />
      </Component>

      <Component Id="ContextMenuEncryptFiles" Guid="*">
        <RegistryValue Root="HKCR" Key="*\shell\ZeeCrypt.Encrypt" Value="Encrypt with ZeeCrypt" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKCR" Key="*\shell\ZeeCrypt.Encrypt" Name="Icon" Value="[APPFOLDER]ZeeCrypt.exe,0" Type="string" />
        <RegistryValue Root="HKCR" Key="*\shell\ZeeCrypt.Encrypt" Name="MultiSelectModel" Value="Player" Type="string" />
        <RegistryValue Root="HKCR" Key="*\shell\ZeeCrypt.Encrypt" Name="AppliesTo" Value="NOT System.FileExtension:=.pcv" Type="string" />
        <RegistryValue Root="HKCR" Key="*\shell\ZeeCrypt.Encrypt\command" Value="&quot;[APPFOLDER]ZeeCrypt.exe&quot; --encrypt -- &quot;%1&quot;" Type="string" />
      </Component>

      <Component Id="ContextMenuEncryptFolders" Guid="*">
        <RegistryValue Root="HKCR" Key="Directory\shell\ZeeCrypt.Encrypt" Value="Encrypt with ZeeCrypt" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKCR" Key="Directory\shell\ZeeCrypt.Encrypt" Name="Icon" Value="[APPFOLDER]ZeeCrypt.exe,0" Type="string" />
        <RegistryValue Root="HKCR" Key="Directory\shell\ZeeCrypt.Encrypt" Name="MultiSelectModel" Value="Player" Type="string" />
        <RegistryValue Root="HKCR" Key="Directory\shell\ZeeCrypt.Encrypt\command" Value="&quot;[APPFOLDER]ZeeCrypt.exe&quot; --encrypt -- &quot;%1&quot;" Type="string" />
      </Component>

      <Component Id="ContextMenuDecrypt" Guid="*">
        <RegistryValue Root="HKCR" Key="ZeeCrypt.pcv\shell\ZeeCrypt.Decrypt" Value="Decrypt with ZeeCrypt" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKCR" Key="ZeeCrypt.pcv\shell\ZeeCrypt.Decrypt" Name="Icon" Value="[APPFOLDER]ZeeCrypt.exe,0" Type="string" />
        <RegistryValue Root="HKCR" Key="ZeeCrypt.pcv\shell\ZeeCrypt.Decrypt" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKCR" Key="ZeeCrypt.pcv\shell\ZeeCrypt.Decrypt\command" Value="&quot;[APPFOLDER]ZeeCrypt.exe&quot; --decrypt -- &quot;%1&quot;" Type="string" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
